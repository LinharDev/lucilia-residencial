---
import { Image } from 'astro:assets';
import vista from '../assets/praias/vista-enseada.jpg';
import CalendarIcon from './CalendarIcon.astro';
---

<section class="banner" aria-labelledby="banner-titulo">
  <Image
    class="banner__foto"
    src={vista}
    alt="Vista da enseada da Pinheira com mar azul, barcos e as montanhas ao fundo"
    widths={[800, 1200, 1600]}
    sizes="100vw"
  />
  <div class="wrap banner__conteudo">
    <h2 id="banner-titulo">Mar calmo, água clara e dias sem pressa.</h2>
    <p>A Enseada da Pinheira é daqueles lugares onde as férias passam devagar, do jeito que tem que ser.</p>
    <a class="btn banner__btn" href="#reservar"><CalendarIcon /> Escolher datas</a>
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(26rem, 70vh, 38rem);
    overflow: hidden;
    color: #fff;
  }
  .banner__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 40 50 / 0.88) 0%, rgb(8 40 50 / 0.6) 45%, rgb(8 40 50 / 0.05) 85%);
  }
  @media (min-width: 960px) {
    .banner::after {
      background: linear-gradient(to right, rgb(8 40 50 / 0.82) 0%, rgb(8 40 50 / 0.45) 45%, rgb(8 40 50 / 0) 75%);
    }
  }
  .banner h2,
  .banner p {
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.25);
  }
  .banner__conteudo {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
  }
  .banner h2 {
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 4rem);
    max-width: 16ch;
  }
  .banner p {
    max-width: 34rem;
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.9);
  }
  .banner__btn {
    margin-top: 0.5rem;
    background: #fff;
    border-color: #fff;
    color: var(--sea);
  }
  .banner__btn:hover {
    background: var(--peach);
    border-color: var(--peach);
  }
</style>

---
import { site } from '../data/site';

// Avaliações publicadas no perfil do Google Maps (copiadas em nov/2026).
// Para atualizar, edite esta lista e o resumo abaixo.
const resumo = { nota: '5,0', total: 4 };
const avaliacoes = [
  {
    autor: 'Mariele S.',
    quando: 'abr. 2026',
    texto:
      'Ótimo lugar e localização, apartamento completo, organizado e limpo. Local tranquilo e a anfitriã muita atenciosa, com certeza iremos voltar!',
  },
  {
    autor: 'Luciana S.',
    quando: '2025',
    texto:
      'Ótimo lugar, organizado, tranquilo, completo. Fiquei nos últimos 2 verões e pretendo ir no próximo o ano que vem!',
  },
  {
    autor: 'Alana L.',
    quando: '2024',
    texto: 'Local super aconchegante perto da praia, recepção incrível! Apartamentos grandes e completos',
  },
];
---

<section id="avaliacoes" class="secao avaliacoes">
  <div class="wrap avaliacoes__grid">
    <div class="resumo">
      <h2>O que dizem os hóspedes</h2>
      <div class="resumo__nota">
        <span class="resumo__numero">{resumo.nota}</span>
        <div>
          <span class="estrelas" aria-hidden="true">★★★★★</span>
          <p class="resumo__total">
            <span class="sr-only">Nota {resumo.nota} de 5, </span>{resumo.total} avaliações no Google
          </p>
        </div>
      </div>
      <div class="resumo__acoes">
        <a class="btn btn--solid" href={site.mapsUrl} target="_blank" rel="noopener">Ver no Google Maps</a>
        <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener">Deixar uma avaliação</a>
      </div>
    </div>

    <ul class="cartoes">
      {
        avaliacoes.map((a) => (
          <li class="cartao">
            <blockquote class="cartao__texto">{a.texto}</blockquote>
            <div class="cartao__rodape">
              <span class="cartao__foto" aria-hidden="true">
                {a.autor.charAt(0)}
              </span>
              <div>
                <p class="cartao__autor">{a.autor}</p>
                <p class="cartao__quando">
                  <span class="estrelas estrelas--p" aria-label="5 estrelas">
                    ★★★★★
                  </span>{' '}
                  no Google, {a.quando}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .avaliacoes {
    background: var(--sky);
  }
  .avaliacoes__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .avaliacoes__grid {
      grid-template-columns: 0.9fr 1.3fr;
      gap: 4rem;
    }
    .resumo {
      position: sticky;
      top: 7rem;
    }
  }

  .resumo__nota {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .resumo__numero {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(4rem, 10vw, 5.5rem);
    line-height: 0.9;
    color: var(--sea);
  }
  .resumo__total {
    color: var(--ink-soft);
    margin-top: 0.15rem;
  }
  .resumo__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .estrelas {
    color: #e9a23b;
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .estrelas--p {
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .cartoes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .cartao {
    display: grid;
    gap: 1.1rem;
    background: var(--paper);
    border-radius: 1rem;
    padding: 1.5rem 1.6rem;
  }
  .cartao__texto {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.3;
    color: var(--sea);
  }
  .cartao__rodape {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cartao__foto {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--peach);
    color: var(--sea);
    font-weight: 700;
  }
  .cartao__autor {
    font-weight: 700;
    color: var(--sea);
  }
  .cartao__quando {
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

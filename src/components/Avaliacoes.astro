---
import { site } from '../data/site';

// Avaliações publicadas no perfil do Google Maps (copiadas em nov/2026).
// Para atualizar, edite esta lista e o resumo abaixo.
const resumo = { nota: '5,0', total: 4 };
const avaliacoes = [
  {
    autor: 'Mariele S.',
    quando: 'abr. 2026',
    texto:
      'Ótimo lugar e localização, apartamento completo, organizado e limpo. Local tranquilo e a anfitriã muita atenciosa, com certeza iremos voltar!',
  },
  {
    autor: 'Luciana S.',
    quando: '2025',
    texto:
      'Ótimo lugar, organizado, tranquilo, completo. Fiquei nos últimos 2 verões e pretendo ir no próximo o ano que vem!',
  },
  {
    autor: 'Alana L.',
    quando: '2024',
    texto: 'Local super aconchegante perto da praia, recepção incrível! Apartamentos grandes e completos',
  },
];
---

<section id="avaliacoes" class="avaliacoes">
  <div class="wrap">
    <div class="avaliacoes__topo">
      <h2>O que dizem os hóspedes</h2>
      <div class="resumo">
        <span class="resumo__numero">{resumo.nota}</span>
        <div class="resumo__info">
          <span class="estrelas" aria-hidden="true">★★★★★</span>
          <p class="resumo__total">
            <span class="sr-only">Nota {resumo.nota} de 5, </span>{resumo.total} avaliações no Google
          </p>
          <a class="resumo__link" href={site.mapsUrl} target="_blank" rel="noopener">Ver no Google Maps</a>
        </div>
      </div>
    </div>

    <ul class="cartoes">
      {
        avaliacoes.map((a) => (
          <li class="cartao">
            <span class="cartao__aspas" aria-hidden="true">
              “
            </span>
            <blockquote class="cartao__texto">{a.texto}</blockquote>
            <div class="cartao__rodape">
              <span class="cartao__foto" aria-hidden="true">
                {a.autor.charAt(0)}
              </span>
              <div>
                <p class="cartao__autor">{a.autor}</p>
                <p class="cartao__quando">
                  <span class="estrelas estrelas--p" aria-label="5 estrelas">
                    ★★★★★
                  </span>
                  <span>Google, {a.quando}</span>
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="avaliacoes__convite">
      Já se hospedou com a gente?
      <a href={site.mapsUrl} target="_blank" rel="noopener">Deixe sua avaliação no Google</a>
    </p>
  </div>
</section>

<style>
  .avaliacoes {
    background: var(--sky);
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .avaliacoes__topo {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 760px) {
    .avaliacoes__topo {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 3rem;
    }
  }

  .resumo {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .resumo__numero {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.75rem, 9vw, 5rem);
    line-height: 0.85;
    color: var(--sea);
  }
  .resumo__info {
    display: grid;
    gap: 0.15rem;
  }
  .resumo__total {
    color: var(--ink-soft);
  }
  .resumo__link {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .estrelas {
    color: #e9a23b;
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .estrelas--p {
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .cartoes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .cartoes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cartao {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--paper);
    border-radius: var(--radius-photo);
    padding: clamp(1.5rem, 3vw, 2rem);
    box-shadow: 0 1.5rem 2.5rem -2rem rgb(14 77 94 / 0.35);
  }
  .cartao__aspas {
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 0.6;
    height: 2rem;
    color: var(--peach-deep);
  }
  .cartao__texto {
    margin: 0;
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.45rem);
    line-height: 1.35;
    color: var(--sea);
  }
  .cartao__rodape {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--peach-soft);
  }
  .cartao__foto {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--peach);
    color: var(--sea);
    font-weight: 700;
  }
  .cartao__autor {
    font-weight: 700;
    color: var(--sea);
  }
  .cartao__quando {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .avaliacoes__convite {
    margin-top: 2rem;
    text-align: center;
    color: var(--ink-soft);
  }
  .avaliacoes__convite a {
    font-weight: 700;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

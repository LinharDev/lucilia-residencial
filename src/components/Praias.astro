---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import pinheira from '../assets/praias/praia-pinheira-morro.jpg';
import cima from '../assets/praias/praia-de-cima.jpg';
import papagaio from '../assets/praias/ponta-do-papagaio.jpg';
import embau from '../assets/praias/guarda-do-embau.jpg';
import costao from '../assets/praias/costao-pinheira.jpg';

const praias = [
  {
    nome: 'Praia da Pinheira',
    tag: 'A 250 m',
    texto: 'Enseada de mar calmo, ótima para crianças, banho de mar e caminhadas no fim da tarde.',
    src: pinheira,
    alt: 'Praia da Pinheira com mar calmo, banhistas e o morro verde ao fundo',
    destaque: true,
  },
  {
    nome: 'Praia de Cima',
    texto: 'Faixa longa de areia e mar aberto, vizinha da Pinheira.',
    src: cima,
    alt: 'Praia de Cima vista do alto, com areia clara e mar azul',
  },
  {
    nome: 'Ponta do Papagaio',
    texto: 'Praia pequena e cercada de verde, com água clara.',
    src: papagaio,
    alt: 'Ponta do Papagaio com árvore na beira do mar e ondas suaves',
  },
  {
    nome: 'Guarda do Embaú',
    texto: 'Onde o rio encontra o mar. Famosa pelo surfe, pelas trilhas e pelos barquinhos da travessia.',
    src: embau,
    alt: 'Barcos amarelos no rio da Guarda do Embaú, com a praia cheia ao fundo',
  },
  {
    nome: 'Costões e trilhas',
    texto: 'Mirantes e trilhas com vista para o mar estão por toda a região.',
    src: costao,
    alt: 'Costão de pedras com árvore e mar azul na região da Pinheira',
  },
];
---

<section id="como-chegar" class="praias">
  <div class="wrap">
    <div class="praias__topo">
      <h2>Praias da região</h2>
      <p class="lede">
        A Pinheira fica no sul de Palhoça, na Grande Florianópolis. Daqui você chega rapidinho a algumas das praias mais
        bonitas de Santa Catarina, como a Praia do Sonho, a Praia de Cima e a Guarda do Embaú.
      </p>
    </div>

    <ul class="praias__grade">
      {
        praias.map((p) => (
          <li class:list={['praia', { 'praia--destaque': p.destaque }]}>
            <Image
              class="praia__foto"
              src={p.src}
              alt={p.alt}
              widths={p.destaque ? [640, 960, 1280] : [400, 640, 800]}
              sizes={p.destaque ? '(min-width: 960px) 66vw, 100vw' : '(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw'}
            />
            <div class="praia__texto">
              {p.tag && <span class="praia__tag">{p.tag}</span>}
              <h3>{p.nome}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="praias__creditos">
      Fotos da Praia de Cima por
      <a href="https://commons.wikimedia.org/wiki/File:Praia_de_Cima,_Pinheira.JPG" target="_blank" rel="noopener">Victoria Kopp</a>
      (<a href="https://creativecommons.org/licenses/by-sa/3.0/deed.pt-br" target="_blank" rel="noopener">CC BY-SA 3.0</a>), da Ponta do
      Papagaio por
      <a href="https://commons.wikimedia.org/wiki/File:Ponta_do_Papagaio_(21395352284).jpg" target="_blank" rel="noopener">Otávio Nogueira</a>
      (<a href="https://creativecommons.org/licenses/by/2.0/deed.pt-br" target="_blank" rel="noopener">CC BY 2.0</a>) e da Guarda do Embaú por
      <a href="https://commons.wikimedia.org/wiki/File:Guarda_do_Emba%C3%BA_05.jpg" target="_blank" rel="noopener">Ulisses Job</a>
      (<a href="https://creativecommons.org/licenses/by-sa/3.0/deed.pt-br" target="_blank" rel="noopener">CC BY-SA 3.0</a>), via Wikimedia
      Commons.
    </p>

    <div class="chegar">
      <div class="chegar__texto">
        <h3>Como chegar</h3>
        <p>{site.street}</p>
        <p>{site.district}, {site.city} - SC</p>
        <p>CEP {site.postalCode}</p>
        <a class="btn btn--solid" href={site.mapsUrl} target="_blank" rel="noopener">Abrir no Google Maps</a>
      </div>
      <iframe
        class="chegar__mapa"
        title="Mapa do Lucília Residencial na Praia da Pinheira, Palhoça, SC"
        src={site.mapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<style>
  .praias {
    background: var(--sky);
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .praias__topo {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  @media (min-width: 960px) {
    .praias__topo {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 3rem;
    }
  }

  .praias__grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 20rem;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .praias__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .praia--destaque {
      grid-column: span 2;
    }
  }
  @media (min-width: 960px) {
    .praias__grade {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 22rem;
      gap: 1.25rem;
    }
  }

  .praia {
    position: relative;
    display: grid;
    align-items: end;
    overflow: hidden;
    border-radius: var(--radius-photo);
    color: #fff;
  }
  .praia__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .praia:hover .praia__foto {
    transform: scale(1.04);
  }
  .praia::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 40 50 / 0.85) 0%, rgb(8 40 50 / 0.25) 50%, rgb(8 40 50 / 0) 70%);
  }
  .praia__texto {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    padding: 1.4rem 1.5rem;
  }
  .praia__texto h3 {
    color: #fff;
    font-size: 1.9rem;
  }
  .praia--destaque .praia__texto h3 {
    font-size: clamp(2.2rem, 4vw, 2.8rem);
  }
  .praia__texto p {
    max-width: 30rem;
    color: rgb(255 255 255 / 0.9);
  }
  .praia__tag {
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--peach);
    color: var(--sea);
    font-size: 0.85rem;
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .praia__foto {
      transition: none;
    }
  }

  .praias__creditos {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .praias__creditos a {
    color: inherit;
  }

  .chegar {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 6vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--paper);
    border-radius: var(--radius-photo);
  }
  .chegar__texto {
    display: grid;
    gap: 0.2rem;
    align-content: center;
    justify-items: start;
  }
  .chegar__texto h3 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }
  .chegar__texto .btn {
    margin-top: 1.25rem;
  }
  .chegar__mapa {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 0;
    border-radius: 0.9rem;
    background: #d4e7ec;
  }
  @media (min-width: 960px) {
    .chegar {
      grid-template-columns: 1fr 2fr;
      gap: 2.5rem;
    }
  }
</style>

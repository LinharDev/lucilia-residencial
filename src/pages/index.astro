---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import WhatsIcon from '../components/WhatsIcon.astro';
import CalendarIcon from '../components/CalendarIcon.astro';
import Reserva from '../components/Reserva.astro';
import Avaliacoes from '../components/Avaliacoes.astro';
import PorDentro from '../components/PorDentro.astro';
import Banner from '../components/Banner.astro';
import Praias from '../components/Praias.astro';
import { whatsappUrl } from '../data/site';
import { site } from '../data/site';

import fachada from '../assets/fotos/fachada-hibiscos.jpg';
import praia from '../assets/fotos/praia-pinheira.jpg';
import suculentas from '../assets/fotos/muro-suculentas.jpg';
import porDoSol from '../assets/fotos/por-do-sol-pinheira.jpg';
import passarela from '../assets/fotos/passarela-praia.jpg';
import areaDescanso from '../assets/fotos/area-descanso.jpg';
import patioHibiscos from '../assets/fotos/patio-hibiscos.jpg';
import escadasJardim from '../assets/fotos/escadas-jardim.jpg';
import palmeira from '../assets/fotos/palmeira-patio.jpg';
import estacionamentoHibiscos from '../assets/fotos/estacionamento-hibiscos.jpg';
import estacionamento from '../assets/fotos/estacionamento.jpg';
import fachada108 from '../assets/fotos/fachada-108.jpg';
import aguaCristalina from '../assets/fotos/agua-cristalina.jpg';
import capa1 from '../assets/videos/apto-1-quarto.jpg';
import capa2 from '../assets/videos/apto-2-quartos.jpg';
import capa3 from '../assets/videos/apto-3-quartos.jpg';

const apartamentos = [
  {
    quartos: '1 quarto',
    para: 'Para casal ou até 2 pessoas',
    texto: 'Apartamento completo com cozinha equipada, ar-condicionado e Wi-Fi. Também temos kitinetes para 2 pessoas.',
    video: '/videos/apto-1-quarto.mp4',
    capa: capa1,
    duracao: '30 s',
  },
  {
    quartos: '2 quartos',
    para: 'Para famílias',
    texto: 'Apartamento completo com cozinha, ar-condicionado, Wi-Fi e churrasqueira individual.',
    video: '/videos/apto-2-quartos.mp4',
    capa: capa2,
    duracao: '30 s',
  },
  {
    quartos: '3 quartos',
    para: 'Para famílias grandes e grupos de amigos',
    texto: 'O maior apartamento do residencial: espaço para todo mundo, cozinha completa e churrasqueira individual.',
    video: '/videos/apto-3-quartos.mp4',
    capa: capa3,
    duracao: '50 s',
  },
];

const apartamentosComCapa = await Promise.all(
  apartamentos.map(async (a) => ({
    ...a,
    capaUrl: (await getImage({ src: a.capa, width: 480, format: 'webp' })).src,
  })),
);

const fotos = [
  { src: fachada, alt: 'Fachada do residencial, com portas de madeira numeradas e hibiscos rosa em primeiro plano' },
  { src: areaDescanso, alt: 'Área de descanso com bancos de madeira, grama e plantas' },
  { src: praia, alt: 'Praia da Pinheira em dia de sol, com pedras na beira da água e o morro ao fundo' },
  { src: patioHibiscos, alt: 'Pátio interno com hibiscos floridos e os apartamentos ao fundo' },
  { src: escadasJardim, alt: 'Escadas externas e jardim com plantas tropicais' },
  { src: aguaCristalina, alt: 'Água cristalina com pedras no fundo, na região da Pinheira' },
  { src: palmeira, alt: 'Palmeira e flores no pátio do residencial' },
  { src: fachada108, alt: 'Entrada de um dos apartamentos, com churrasqueira e ar-condicionado' },
  { src: porDoSol, alt: 'Pôr do sol na areia da Praia da Pinheira' },
  { src: suculentas, alt: 'Muro branco decorado com vasos de suculentas e plaquinhas escritas Paz, Amor e Paraíso' },
  { src: estacionamentoHibiscos, alt: 'Hibiscos floridos ao lado do estacionamento' },
  { src: estacionamento, alt: 'Estacionamento do residencial com piso de lajotas e jardim' },
  { src: passarela, alt: 'Passarela de madeira chegando à areia, com mar e ilhas ao fundo' },
];

const fotosGaleria = await Promise.all(
  fotos.map(async (f) => ({
    ...f,
    full: (await getImage({ src: f.src, width: Math.min(f.src.width, 1400), format: 'webp' })).src,
  })),
);

const comodidades = [
  '250 m da Praia da Pinheira',
  'Apartamentos de 1, 2 e 3 quartos',
  'Ar-condicionado em todas as unidades',
  'Wi-Fi',
  'Garagem coberta',
  'Cozinha completa',
  'Churrasqueira individual',
  'Aberto o ano todo',
];
---

<Base>
  <header class="topo">
    <div class="wrap topo__inner">
      <a href="/" class="topo__logo" aria-label="Lucília Residencial, início"><Logo /></a>
      <nav aria-label="Seções">
        <ul class="topo__nav">
          <li><a href="#apartamentos">Apartamentos</a></li>
          <li><a href="#fotos">Fotos</a></li>
          <li><a href="#avaliacoes">Avaliações</a></li>
          <li><a href="#como-chegar">Praias</a></li>
        </ul>
      </nav>
      <a class="btn btn--solid topo__cta" href="#reservar">Reservar</a>
    </div>
  </header>

  <main id="conteudo">
    <!-- HERO: o caminho de 250 m entre a porta e o mar -->
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__texto">
          <h1>Seu refúgio a 250&nbsp;metros do mar, na Praia da Pinheira.</h1>
          <p class="lede">
            Apartamentos por temporada de 1, 2 e 3 quartos na Praia da Pinheira, SC. Estamos abertos o ano todo.
          </p>
          <div class="hero__acoes">
            <a class="btn btn--solid" href="#reservar"><CalendarIcon /> Escolher datas</a>
            <a class="btn btn--ghost" href="#apartamentos">Ver apartamentos</a>
          </div>
        </div>

        <figure class="caminho" aria-label="Do residencial até a Praia da Pinheira: cerca de 3 minutos a pé">
          <Image
            class="caminho__casa"
            src={fachada}
            alt="Fachada do Lucília Residencial com hibiscos rosa"
            widths={[360, 560, 800]}
            sizes="(min-width: 960px) 30vw, 56vw"
            loading="eager"
            fetchpriority="high"
          />
          <Image
            class="caminho__mar"
            src={praia}
            alt="Praia da Pinheira em dia de sol"
            widths={[360, 560, 800]}
            sizes="(min-width: 960px) 32vw, 60vw"
            loading="eager"
          />
          <svg class="caminho__trilha" viewBox="0 0 500 600" aria-hidden="true">
            <defs>
              <mask id="desenho">
                <path class="caminho__mascara" d="M282 128 C 430 118, 492 236, 418 338" />
              </mask>
            </defs>
            <circle cx="282" cy="128" r="6" class="caminho__ponto" />
            <path class="caminho__linha" d="M282 128 C 430 118, 492 236, 418 338" mask="url(#desenho)" />
            <path class="caminho__seta" d="M408 326 l10 13 l6 -15" />
          </svg>
          <figcaption class="caminho__legenda">
            <span class="caminho__metros">250 m</span>
            <span class="caminho__tempo">cerca de 3 minutos a pé</span>
          </figcaption>
        </figure>
      </div>

      <div class="faixa" role="region" aria-label="Comodidades">
        <div class="faixa__trilho">
          <ul class="hex-list faixa__lista">
            {comodidades.map((c) => <li>{c}</li>)}
          </ul>
          <ul class="hex-list faixa__lista faixa__lista--copia" aria-hidden="true">
            {comodidades.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- APARTAMENTOS -->
    <section id="apartamentos" class="secao aptos">
      <div class="wrap">
        <div class="secao__topo">
          <h2>Apartamentos</h2>
          <p class="lede">
            Todas as unidades são completas: é só chegar com a mala. Escolha o apartamento ideal para você, sua família ou
            seus amigos.
          </p>
        </div>

        <ul class="aptos__lista">
          {
            apartamentosComCapa.map((a) => (
              <li class="apto">
                <div class="apto__info">
                  <h3 class="apto__quartos">{a.quartos}</h3>
                  <div class="apto__desc">
                    <p class="apto__para">{a.para}</p>
                    <p class="apto__texto">{a.texto}</p>
                  </div>
                </div>
                <figure class="apto__video">
                  <video
                    controls
                    muted
                    playsinline
                    preload="none"
                    poster={a.capaUrl}
                    width="480"
                    height="850"
                    aria-label={`Vídeo do apartamento de ${a.quartos}`}
                  >
                    <source src={a.video} type="video/mp4" />
                  </video>
                  <figcaption>Vídeo do apartamento de {a.quartos} ({a.duracao})</figcaption>
                </figure>
              </li>
            ))
          }
        </ul>

        <PorDentro />

        <div class="aptos__nota">
          <p>Valores de diárias conforme o número de pessoas e o período.</p>
          <a class="btn btn--solid" href="#reservar"><CalendarIcon /> Consultar datas e valores</a>
        </div>
      </div>
    </section>

    <!-- O RESIDENCIAL -->
    <section class="secao lugar">
      <div class="wrap lugar__grid">
        <div class="lugar__fotos">
          <Image class="lugar__f1" src={areaDescanso} alt="Área de descanso com bancos de madeira, grama e plantas" widths={[480, 800, 1100]} sizes="(min-width: 960px) 34vw, 90vw" />
          <Image class="lugar__f2" src={patioHibiscos} alt="Pátio com hibiscos floridos e os apartamentos ao fundo" widths={[320, 480, 640]} sizes="(min-width: 960px) 18vw, 45vw" />
        </div>
        <div class="lugar__texto">
          <h2>Conforto de casa, a poucos passos do mar</h2>
          <p>
            O Lucília Residencial é um espaço familiar na Enseada da Pinheira, em Palhoça. Os apartamentos ficam em volta
            de um pátio florido e arejado, longe do barulho e perto de tudo o que você precisa para curtir a praia.
          </p>
          <p>
            Cada unidade é completa e pronta para receber você: é só trazer a mala. Ideal para as férias de verão, um fim
            de semana de descanso ou uma temporada de home office com vista para a rotina da praia.
          </p>
          <ul class="hex-list lugar__lista">
            <li>Ambiente tranquilo, seguro e acolhedor</li>
            <li>Ar-condicionado e Wi-Fi em todas as unidades</li>
            <li>Churrasqueira individual nos apartamentos de 2 e 3 quartos</li>
            <li>Garagem coberta</li>
            <li>Atendimento próximo e atencioso, direto pelo WhatsApp</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- AVALIAÇÕES (ao vivo, via Google Maps) -->
    <Avaliacoes />

    <!-- FAIXA COM FOTO -->
    <Banner />

    <!-- FOTOS -->
    <section id="fotos" class="secao fotos">
      <div class="wrap">
        <div class="secao__topo">
          <h2>Fotos</h2>
          <p class="lede">
            Mais fotos e vídeos no nosso Instagram,
            <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a>.
          </p>
        </div>
        <ul class="galeria">
          {
            fotosGaleria.map((f, i) => (
              <li class={`galeria__item galeria__item--${i}`}>
                <button type="button" class="galeria__btn" data-index={i} data-full={f.full} data-alt={f.alt}>
                  <Image
                    src={f.src}
                    alt={f.alt}
                    widths={i === 0 ? [480, 800, 1080] : [320, 520]}
                    sizes={i === 0 ? '(min-width: 760px) 50vw, 100vw' : '(min-width: 760px) 25vw, 50vw'}
                  />
                  <span class="sr-only">Ampliar foto</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <dialog class="lightbox" aria-label="Foto ampliada">
        <img class="lightbox__img" src={fotosGaleria[0].full} alt={fotosGaleria[0].alt} loading="lazy" />
        <button type="button" class="lightbox__btn lightbox__fechar" aria-label="Fechar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <button type="button" class="lightbox__btn lightbox__ant" aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="lightbox__btn lightbox__prox" aria-label="Próxima foto">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </dialog>
    </section>

    <!-- COMO CHEGAR / ARREDORES -->
    <Praias />

    <!-- RESERVA -->
    <Reserva />
  </main>

  <footer class="rodape">
    <div class="wrap rodape__inner">
      <Logo tone="light" />
      <p>Praia da Pinheira, Palhoça - SC</p>
      <div class="rodape__copy">
        <p>© {new Date().getFullYear()} Lucília Residencial. Todos os direitos reservados.</p>
        <p>
          Desenvolvido por LC Dev, da{' '}
          <a href="https://lcdevs.vercel.app/" target="_blank" rel="noopener">JL Devs</a>
        </p>
      </div>
    </div>
  </footer>

  <a class="whats-flutuante" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Reservar pelo WhatsApp">
    <WhatsIcon />
  </a>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
  const botoes = [...document.querySelectorAll<HTMLButtonElement>('.galeria__btn')];
  let atual = 0;
  let origem: HTMLButtonElement | null = null;

  function mostrar(i: number) {
    atual = (i + botoes.length) % botoes.length;
    const b = botoes[atual];
    img.src = b.dataset.full!;
    img.alt = b.dataset.alt!;
  }

  botoes.forEach((b, i) =>
    b.addEventListener('click', () => {
      origem = b;
      mostrar(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector('.lightbox__fechar')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lightbox__ant')!.addEventListener('click', () => mostrar(atual - 1));
  dialog.querySelector('.lightbox__prox')!.addEventListener('click', () => mostrar(atual + 1));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') mostrar(atual - 1);
    if (e.key === 'ArrowRight') mostrar(atual + 1);
  });
  dialog.addEventListener('close', () => origem?.focus());

  // Vídeos dos apartamentos: ao dar play em um, pausa os outros
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.apto__video video')];
  videos.forEach((v) => v.addEventListener('play', () => videos.forEach((o) => o !== v && o.pause())));
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Topo */
  .topo {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--peach-soft);
  }
  .topo__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: clamp(4.75rem, 9vw, 5.5rem);
  }
  .topo__logo {
    text-decoration: none;
    font-size: clamp(1.3rem, 3.5vw, 1.55rem);
  }
  .topo nav {
    margin-left: auto;
  }
  .topo__nav {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topo__nav a {
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .topo__nav a:hover {
    text-decoration: underline;
  }
  .topo__cta {
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
  }
  @media (max-width: 760px) {
    .topo nav,
    .topo__cta {
      display: none;
    }
  }

  /* Hero */
  .hero {
    padding-top: clamp(2rem, 6vw, 4.5rem);
  }
  /* Faixa de comodidades: carrossel contínuo */
  .faixa {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    background: var(--peach-soft);
    overflow: hidden;
    padding-block: 1.6rem;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .faixa__trilho {
    display: flex;
    width: max-content;
    animation: rolar 38s linear infinite;
  }
  .faixa:hover .faixa__trilho {
    animation-play-state: paused;
  }
  .faixa__lista {
    display: flex;
    flex: none;
    gap: 3rem;
    padding-right: 3rem;
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--sea);
    white-space: nowrap;
  }
  @keyframes rolar {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faixa {
      mask-image: none;
    }
    .faixa__trilho {
      animation: none;
      width: auto;
      justify-content: center;
    }
    .faixa__lista {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem 2.25rem;
      padding-inline: var(--gutter);
      white-space: normal;
    }
    .faixa__lista--copia {
      display: none;
    }
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 7.5vw, 5.25rem);
    line-height: 1;
    max-width: 12ch;
  }
  .hero .lede {
    margin-top: 1.5rem;
  }
  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .caminho {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
    aspect-ratio: 5 / 6;
  }
  .caminho__casa,
  .caminho__mar {
    position: absolute;
    object-fit: cover;
    border-radius: var(--radius-photo);
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(14 77 94 / 0.45);
  }
  .caminho__casa {
    left: 0;
    top: 0;
    width: 56%;
    height: 58.3%;
  }
  .caminho__mar {
    right: 0;
    bottom: 0;
    width: 60%;
    height: 45%;
  }
  .caminho__trilha {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .caminho__ponto {
    fill: var(--hibisco);
  }
  .caminho__linha {
    fill: none;
    stroke: var(--sea);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 0.1 12;
  }
  .caminho__seta {
    fill: none;
    stroke: var(--sea);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: aparecer 0.3s ease-out 1.5s both;
  }
  .caminho__mascara {
    fill: none;
    stroke: #fff;
    stroke-width: 14;
    stroke-dasharray: 360;
    stroke-dashoffset: 360;
    animation: desenhar 1.4s cubic-bezier(0.6, 0, 0.3, 1) 0.35s forwards;
  }
  .caminho__legenda {
    position: absolute;
    left: 66%;
    top: 34%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.1;
    animation: aparecer 0.5s ease-out 1.2s both;
  }
  .caminho__metros {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    color: var(--sea);
    background: var(--paper);
    padding: 0 0.3rem;
    border-radius: 0.4rem;
  }
  .caminho__tempo {
    font-size: 0.82rem;
    color: var(--ink-soft);
    background: var(--paper);
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .caminho__legenda {
      left: 60%;
    }
    .caminho__tempo {
      white-space: normal;
      max-width: 7.5rem;
    }
  }
  @keyframes desenhar {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caminho__mascara {
      animation: none;
      stroke-dashoffset: 0;
    }
    .caminho__seta,
    .caminho__legenda {
      animation: none;
    }
  }

  /* Seções */
  .secao {
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .secao__topo {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 960px) {
    .secao__topo {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 3rem;
    }
  }

  /* Apartamentos */
  .aptos__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--sea);
  }
  .apto {
    display: grid;
    gap: 1.5rem 3rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--peach);
  }
  .apto__info {
    display: grid;
    gap: 0.4rem 2rem;
    align-content: center;
  }
  .apto__desc {
    display: grid;
    gap: 0.4rem;
  }
  .apto__video {
    margin: 0;
    width: min(100%, 17rem);
  }
  .apto__video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: var(--radius-photo);
    background: var(--sky);
